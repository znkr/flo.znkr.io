#let article(title: none, published: none, updated: none, summary: none) = {
    if type(published) == str {
        published = datetime.parse_date(published)
    }
    if type(updated) == str {
        updated = datetime.parse_date(updated)
    }
    set document(title: title)
    [
        #metadata((
            title: title,
            type: "article",
            published: published,
            updated: updated,
            summary: summary,
        )) <doc-meta>
    ]
}

#let page(title: none, summary: none, header: none, content) = {
    set document(title: title)
    [
        #metadata((
            title: title,
            type: "page",
            summary: summary,
        )) <doc-meta>
    ]
    html.elem("header", attrs: (class: "header page-header"), header)
    html.elem("div", attrs: (class: "content"), content)
}
