&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;2&lt;/td&gt;&lt;td class="line-no"&gt;2&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="delete"&gt;&lt;td class="line-no"&gt;3&lt;/td&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;func&lt;/span&gt; greet() string {
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="delete"&gt;&lt;td class="line-no"&gt;4&lt;/td&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	&lt;span class="hl-b"&gt;return&lt;/span&gt; &lt;span class="hl-i"&gt;&amp;#34;hi&amp;#34;&lt;/span&gt;
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="insert"&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="line-no"&gt;3&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;func&lt;/span&gt; greet(name string) string {
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="insert"&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="line-no"&gt;4&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	&lt;span class="hl-b"&gt;return&lt;/span&gt; &lt;span class="hl-i"&gt;&amp;#34;hi, &amp;#34;&lt;/span&gt; + name
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;5&lt;/td&gt;&lt;td class="line-no"&gt;5&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;}
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h2 id="from-two-files"&gt;From Two Files&lt;a href="#from-two-files" class="anchor-link"&gt;&lt;/a&gt;&lt;/h2&gt;
&lt;table class="code-snippet diff"&gt;&lt;caption&gt;after.go (/diffs/after.go)&lt;/caption&gt;&lt;tbody&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;1&lt;/td&gt;&lt;td class="line-no"&gt;1&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;package&lt;/span&gt; main
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;2&lt;/td&gt;&lt;td class="line-no"&gt;2&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;3&lt;/td&gt;&lt;td class="line-no"&gt;3&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;func&lt;/span&gt; sum(vs []int) int {
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="delete"&gt;&lt;td class="line-no"&gt;4&lt;/td&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	total := 0
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="delete"&gt;&lt;td class="line-no"&gt;5&lt;/td&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	&lt;span class="hl-b"&gt;for&lt;/span&gt; i := 0; i &amp;lt; &lt;span class="hl-bl"&gt;len&lt;/span&gt;(vs); i++ {
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="delete"&gt;&lt;td class="line-no"&gt;6&lt;/td&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;		total += vs[i]
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="insert"&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="line-no"&gt;4&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	&lt;span class="hl-b"&gt;var&lt;/span&gt; total int
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="insert"&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="line-no"&gt;5&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	&lt;span class="hl-b"&gt;for&lt;/span&gt; _, v := &lt;span class="hl-b"&gt;range&lt;/span&gt; vs {
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="insert"&gt;&lt;td class="line-no"&gt;-1&lt;/td&gt;&lt;td class="line-no"&gt;6&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;		total += v
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;7&lt;/td&gt;&lt;td class="line-no"&gt;7&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	}
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;8&lt;/td&gt;&lt;td class="line-no"&gt;8&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	&lt;span class="hl-b"&gt;return&lt;/span&gt; total
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src" data-op="match"&gt;&lt;td class="line-no"&gt;9&lt;/td&gt;&lt;td class="line-no"&gt;9&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;}
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;</content></entry><entry><title>Snippets</title><id>tag:znkr.io,2024:articles/snippets</id><link rel="alternate" href="https://flo.znkr.io/snippets"/><published>2025-01-02T00:00:00+00:00</published><updated>2025-03-04T00:00:00+00:00</updated><author><name>Florian Zenker</name></author><summary type="html">An article that includes snippets, so that include-snippet stays covered.</summary><content type="html">&lt;h2 id="whole-file"&gt;Whole File&lt;a href="#whole-file" class="anchor-link"&gt;&lt;/a&gt;&lt;/h2&gt;
&lt;p&gt;The whole file, syntax highlighted based on its extension:&lt;/p&gt;
&lt;table class="code-snippet"&gt;&lt;caption&gt;hello.go (/snippets/hello.go)&lt;/caption&gt;&lt;tbody&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;1&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;package&lt;/span&gt; main
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;2&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;3&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;import&lt;/span&gt; &lt;span class="hl-i"&gt;&amp;#34;fmt&amp;#34;&lt;/span&gt;
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;4&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;5&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;func&lt;/span&gt; main() {
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;6&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	fmt.Println(&lt;span class="hl-i"&gt;&amp;#34;hello, world&amp;#34;&lt;/span&gt;)
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;7&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;}
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;
&lt;h2 id="part-of-a-file"&gt;Part Of A File&lt;a href="#part-of-a-file" class="anchor-link"&gt;&lt;/a&gt;&lt;/h2&gt;
&lt;p&gt;Only the body, with an explicit display name:&lt;/p&gt;
&lt;table class="code-snippet"&gt;&lt;caption&gt;the body (/snippets/hello.go)&lt;/caption&gt;&lt;tbody&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;5&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;&lt;span class="hl-b"&gt;func&lt;/span&gt; main() {
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;6&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;	fmt.Println(&lt;span class="hl-i"&gt;&amp;#34;hello, world&amp;#34;&lt;/span&gt;)
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr class="src"&gt;&lt;td class="line-no"&gt;7&lt;/td&gt;&lt;td class="code"&gt;&lt;code&gt;}
&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;&lt;/table&gt;</content></entry></feed>